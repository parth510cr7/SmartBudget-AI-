{
  "name": "smartbudgetai-workspace",
  "private": true,
  "description": "Root scripts only; app code lives in backend/ and frontend/",
  "scripts": {
    "verify": "node scripts/verify-dev-tooling.mjs",
    "qa:smoke": "node scripts/qa-smoke.mjs",
    "qa:backend:test": "npm --prefix backend test",
    "qa:loop": "powershell -ExecutionPolicy Bypass -File scripts/qa-loop.ps1",
    "graphify:cursor-rule": "python -m graphify cursor install",
    "graphify:query": "python -m graphify query"
  }
}
