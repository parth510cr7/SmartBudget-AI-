# Copy this file to .env and fill in the values. Do not commit .env.

# PostgreSQL (required). Prisma uses DATABASE_URL first when both are set (unless USE_DIRECT_URL=true).
#
# Supabase: copy the URI from Project Settings → Database → Connection string. If you use the pooler host
# (*.pooler.supabase.com), the username must be postgres.PROJECT_REF — not plain "postgres" — or you get
# FATAL / XX000 "Tenant or user not found". Direct connections use host db.PROJECT_REF.supabase.co and user postgres.
DATABASE_URL="postgresql://postgres.PROJECT_REF:PASSWORD@aws-0-REGION.pooler.supabase.com:6543/postgres?sslmode=require"
# Optional: direct session (db.PROJECT_REF.supabase.co:5432, user postgres). Set USE_DIRECT_URL=true to prefer over DATABASE_URL.
# DIRECT_URL="postgresql://postgres:PASSWORD@db.PROJECT_REF.supabase.co:5432/postgres?sslmode=require"
# USE_DIRECT_URL=false

# Cloud AI removed (on-device-only mode). No API keys required.

# Server port (optional; default 8080). Server binds to 0.0.0.0 so it's reachable at your machine's LAN IP (e.g. http://10.0.0.47:8080) for frontend on device.
PORT=8080

# Firebase / Google Cloud (required in production for auth; optional for local dev with dev-token)
# Use one of:
FIREBASE_PROJECT_ID=""
# OR
GOOGLE_CLOUD_PROJECT=""
# OR path to service account JSON for verifyIdToken
GOOGLE_APPLICATION_CREDENTIALS=""

# Set to "production" to disable dev-token auth bypass
NODE_ENV=development

# Receipt parsing: reduce API usage on free tier
# RECEIPT_CLOUD_FALLBACK_ENABLED=0   — disable all cloud fallback (no Gemini calls)
# RECEIPT_USE_CLOUD_WHEN_NEEDS_REVIEW=0 — skip cloud when local result is "needs review" (fewer calls; more receipts stay Pending Review)
