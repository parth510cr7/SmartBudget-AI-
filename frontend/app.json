{
  "expo": {
    "name": "SmartBudget AI",
    "slug": "smartbudget-ai",
    "scheme": "smartbudget",
    "version": "1.0.0",
    "orientation": "portrait",
    "icon": "./assets/icon.png",
    "userInterfaceStyle": "light",
    "splash": {
      "image": "./assets/splash-icon.png",
      "resizeMode": "contain",
      "backgroundColor": "#ffffff"
    },
    "ios": {
      "supportsTablet": true,
      "bundleIdentifier": "com.parth510.smartbudgetai",
      "infoPlist": {
        "ITSAppUsesNonExemptEncryption": false,
        "NSLocationWhenInUseUsageDescription": "SmartBudget AI uses your location only to show nearby community price averages (within 30 km). Your exact address is never shared with others; results are anonymous and aggregated. You can turn this off anytime in Profile → Privacy & location."
      }
    },
    "android": {
      "package": "com.parth510.smartbudgetai",
      "adaptiveIcon": {
        "backgroundColor": "#E6F4FE",
        "foregroundImage": "./assets/android-icon-foreground.png",
        "backgroundImage": "./assets/android-icon-background.png",
        "monochromeImage": "./assets/android-icon-monochrome.png"
      },
      "predictiveBackGestureEnabled": false,
      "permissions": [
        "android.permission.CAMERA",
        "android.permission.RECORD_AUDIO",
        "android.permission.ACCESS_COARSE_LOCATION",
        "android.permission.ACCESS_FINE_LOCATION"
      ]
    },
    "web": {
      "favicon": "./assets/favicon.png"
    },
    "plugins": [
      "expo-router",
      "expo-apple-authentication",
      [
        "expo-build-properties",
        {
          "ios": { "deploymentTarget": "15.1" },
          "android": { "minSdkVersion": 24, "usesCleartextTraffic": true }
        }
      ],
      [
        "expo-camera",
        {
          "cameraPermission": "Allow SmartBudget AI to access your camera to scan receipts."
        }
      ],
      [
        "expo-location",
        {
          "locationWhenInUsePermission": "SmartBudget AI uses your location only to show nearby community price averages (within 30 km). Your exact address is never shared; results are anonymous. You can turn this off in Profile → Privacy & location."
        }
      ]
    ],
    "updates": {
      "enabled": false
    },
    "extra": {
      "router": {},
      "eas": {
        "projectId": "dc606802-ca5e-483d-971d-146760b4b9ef"
      }
    }
  }
}
