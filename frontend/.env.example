# Copy this file to .env or .env.local and set your backend URL.
# Backend runs on port 8080. Restart Expo after changing: npx expo start -c

# EXPO_PUBLIC_API_URL = backend base URL (no trailing slash):
# - iOS Simulator:          http://localhost:8080
# - Android Emulator:       http://10.0.2.2:8080
# - Physical device (Wi-Fi): http://YOUR_COMPUTER_IP:8080  (e.g. http://10.0.0.47:8080)
EXPO_PUBLIC_API_URL=http://localhost:8080

# Firebase client — copy the Web app object from Firebase Console → Project settings → Your apps.
# All of the following must be non-empty or the app shows "Firebase not configured":
EXPO_PUBLIC_FIREBASE_API_KEY=
EXPO_PUBLIC_FIREBASE_AUTH_DOMAIN=
EXPO_PUBLIC_FIREBASE_PROJECT_ID=
EXPO_PUBLIC_FIREBASE_STORAGE_BUCKET=
EXPO_PUBLIC_FIREBASE_MESSAGING_SENDER_ID=
EXPO_PUBLIC_FIREBASE_APP_ID=
# EXPO_PUBLIC_FIREBASE_MEASUREMENT_ID=   # optional (Analytics)
#
# Also in Firebase Console → Authentication → Sign-in method: enable Google and Apple (configure Apple per Firebase docs).

# Google Sign-In (OAuth 2.0 Client IDs from Google Cloud Console → APIs & Services → Credentials)
# Use the Web application client ID for Expo id-token flow; add iOS client ID if you use an iOS-only OAuth client.
EXPO_PUBLIC_GOOGLE_WEB_CLIENT_ID=
EXPO_PUBLIC_GOOGLE_IOS_CLIENT_ID=
# EXPO_PUBLIC_GOOGLE_ANDROID_CLIENT_ID=
